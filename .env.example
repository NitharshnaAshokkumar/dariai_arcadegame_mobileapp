# ==============================================================================
# DaRI AI Arcade — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / Mac:          cp .env.example .env
# ==============================================================================

# Server Port (Default: 8787 to match Google OAuth authorized callback)
PORT=8787
FRONTEND_URL=http://127.0.0.1:8787

# Google OAuth 2.0 Web Client Credentials
# Note: In Google Cloud Console, ensure Authorized redirect URIs includes:
#   http://127.0.0.1:8787/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Secret for local dev / sessions
JWT_SECRET=super-secret-jwt-key-for-local-dev

# DaRI Admin Role Configuration
# Comma-separated list of verified Google emails granted DaRI Admin privileges.
# All other users logging in automatically enter as 'DaRI Participant' (no prompt in frontend).
ADMIN_EMAILS=admin@dariai.tech,organizer@dariai.tech
ADMIN_PASSWORD=1234

